#!/bin/sh
### BEGIN INIT INFO
# Provides:          can-visualizer
# Required-Start:    $remote_fs $syslog can-server
# Required-Stop:     $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Start CAN visualizer
# Description:       Qt6 QML CAN data visualization application
### END INIT INFO

# Qt6 EGLFS configuration for fullscreen embedded mode
export QT_QPA_PLATFORM=eglfs
export QT_QPA_EGLFS_ALWAYS_SET_MODE=1
export QT_QPA_EGLFS_KMS_ATOMIC=1
export QT_LOGGING_RULES="*.debug=false;qt.qpa.*=false"

DAEMON=/usr/bin/can-visualizer
PIDFILE=/var/run/can-visualizer.pid
NAME=can-visualizer
DESC="CAN Visualizer"

# Check if daemon exists
test -x $DAEMON || exit 0

case "$1" in
    start)
        echo "Starting $DESC in 3 seconds..."
        sleep 3
        echo "Starting $NAME (foreground mode - press Ctrl+C to stop)"
        # Attach to console TTY for keyboard input
        setsid sh -c "exec $DAEMON < /dev/tty1 > /dev/tty1 2>&1" &
        ;;

    stop)
        echo -n "Stopping $DESC: "
        killall $NAME 2>/dev/null
        echo "done."
        ;;

    restart|force-reload)
        echo -n "Restarting $DESC: "
        killall $NAME 2>/dev/null
        sleep 3
        echo "Starting $NAME (foreground mode - press Ctrl+C to stop)"
        # Attach to console TTY for keyboard input
        setsid sh -c "exec $DAEMON < /dev/tty1 > /dev/tty1 2>&1" &
        ;;

    status)
        if pgrep -x $NAME > /dev/null; then
            echo "$NAME is running"
            exit 0
        else
            echo "$NAME is not running"
            exit 3
        fi
        ;;

    *)
        echo "Usage: $0 {start|stop|restart|force-reload|status}"
        exit 1
        ;;
esac

exit 0
